# Copie para .env.local (desenvolvimento) e cadastre as mesmas variáveis na Vercel.
# Project Settings → API, no Supabase:
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole-a-chave-anon-public
# Só no servidor (nunca no navegador). Usada para convidar membros da equipe.
SUPABASE_SERVICE_ROLE_KEY=
# Chave da API da Anthropic (console.anthropic.com), para as análises do Claude.
ANTHROPIC_API_KEY=
