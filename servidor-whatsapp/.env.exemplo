# Copie para ".env" e troque os valores marcados. NUNCA envie este arquivo para ninguém.
# Chave de acesso do servidor (gere uma longa: no terminal, `openssl rand -hex 24`). A mesma vai na Vercel como EVOLUTION_API_KEY.
AUTHENTICATION_API_KEY=TROQUE_POR_UMA_CHAVE_LONGA
# Endereço público do servidor (com https, se tiver domínio: ex. https://whatsapp.advocaciapassos.com.br)
SERVER_URL=http://IP_DO_SERVIDOR:8080
POSTGRES_PASSWORD=TROQUE_POR_UMA_SENHA_LONGA
DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://evolution:TROQUE_POR_UMA_SENHA_LONGA@evolution-postgres:5432/evolution?schema=public
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=true
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://evolution-redis:6379/0
CACHE_REDIS_PREFIX_KEY=evolution
CACHE_LOCAL_ENABLED=false
QRCODE_LIMIT=30
# fuso de São Paulo nos registros
TZ=America/Sao_Paulo
